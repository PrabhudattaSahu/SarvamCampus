# Copy this file to ~/.studynotes/.env  (or next to the executable) and fill in.
# With every provider left as `mock` the app runs fully offline on canned data.

# --- Provider selection -----------------------------------------------------
# ocr: mock | vision_llm
# llm: mock | openai_compatible
# tts: mock | openai_compatible
OCR_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# --- LLM (any OpenAI-compatible /chat/completions endpoint) -----------------
# OpenAI      -> https://api.openai.com/v1
# Sarvam AI   -> https://api.sarvam.ai/v1        (Indic-first)
# Groq        -> https://api.groq.com/openai/v1
# local vLLM  -> http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Vision model used by the OCR step (must accept images). Defaults to LLM_MODEL.
LLM_VISION_MODEL=

# --- Text-to-speech (OpenAI-compatible /audio/speech) -----------------------
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Processing -------------------------------------------------------------
RENDER_DPI=200
MAX_PAGES=40
REQUEST_TIMEOUT=120
